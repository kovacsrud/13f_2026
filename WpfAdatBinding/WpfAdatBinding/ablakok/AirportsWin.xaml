<Window x:Class="WpfAdatBinding.ablakok.AirportsWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAdatBinding.ablakok"
        mc:Ignorable="d"
        Title="AirportsWin" Height="450" Width="800">
    <Grid>
        <DataGrid ItemsSource="{Binding Airports}" AutoGenerateColumns="False" ColumnWidth="*">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Reptér kód" Binding="{Binding AirportCode}" />
                <DataGridTextColumn Header="Reptér neve" Binding="{Binding AirportName}" />
                <DataGridTextColumn Header="Reptér országkód" Binding="{Binding AirportCountryCode}" />
                <DataGridTextColumn Header="Reptér magassága" Binding="{Binding AirportElevation}" />
                <DataGridTextColumn Header="Kontinens" Binding="{Binding AirportContinent}" />
                
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Window>
