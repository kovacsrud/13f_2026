<Window x:Class="WpfNotepad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfNotepad"
        mc:Ignorable="d"
        Title="Notepad" Height="450" Width="800" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu FontSize="20">
            <MenuItem Header="Fájl">
                <MenuItem x:Name="menuitemMegnyitas" Header="Megnyitás" Click="menuitemMegnyitas_Click"/>
                <Separator  Height="2" Background="Black"/>
                <MenuItem x:Name="menuitemMentes" Header="Mentés" Click="menuitemMentes_Click" />
                <MenuItem x:Name="menuitemMentesMaskent" Header="Mentés másként" Click="menuitemMentesMaskent_Click"/>
                <Separator  Height="2" Background="Black"/>
                <MenuItem x:Name="menuitemKilepes" Header="Kilépés" Click="menuitemKilepes_Click" />
            </MenuItem>
            <MenuItem Header="Szerkesztés">
                <MenuItem x:Name="menuitemKivagas" Header="Kivágás" Click="menuitemKivagas_Click" IsEnabled="False"/>
                <MenuItem x:Name="menuitemMasolas" Header="Másolás" Click="menuitemMasolas_Click" IsEnabled="False" />
                <Separator  Height="2" Background="Black"/>
                <MenuItem x:Name="menuitemBeillesztes" Header="Beillesztés" Click="menuitemBeillesztes_Click" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="Súgó">
                <MenuItem Header="Névjegy" />
            </MenuItem>
            
        </Menu>
        <TextBox x:Name="textboxSzoveg" Grid.Row="1" FontSize="24" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Visible" TextChanged="textboxSzoveg_TextChanged" SelectionChanged="textboxSzoveg_SelectionChanged"/>

    </Grid>
</Window>
