<Window x:Class="WpfSlideshow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSlideshow"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Image x:Name="kep" Grid.ColumnSpan="2"/>
        <Button x:Name="buttonBetoltes" Content="Képek kiválasztása" Grid.Row="1" Width="200" Height="30" Click="buttonBetoltes_Click"/>
        <Button x:Name="buttonIdozito" Content="Start" Grid.Column="1" Grid.Row="1" Width="200" Height="30" IsEnabled="False" Click="buttonIdozito_Click"/>


    </Grid>
</Window>
